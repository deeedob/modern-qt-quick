#pragma once

#include <QtCore/QDebug>

#include <string_view>

namespace app {

struct BuildInfo
{
    std::string_view name;
    std::string_view displayName;
    std::string_view version;
    std::string_view gitSha;
    std::string_view buildType;
    std::string_view buildTimestamp;
    std::string_view compiler;
    std::string_view system;
};

inline constexpr BuildInfo buildInfo{
    .name = "@PROJECT_NAME@",
    .displayName = "@APP_DISPLAY_NAME@",
    .version = "@PROJECT_VERSION@",
    .gitSha = "@APP_GIT_SHA@",
    .buildType = "$<CONFIG>",
    .buildTimestamp = "@APP_BUILD_TIMESTAMP@",
    .compiler = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@",
    .system = "@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@",
};

inline QDebug operator<<(QDebug debug, const BuildInfo &info)
{
    const QDebugStateSaver saver(debug);
    debug.noquote().nospace() << info.name << ' ' << info.version << " (" << info.gitSha << ", "
                              << info.buildType << ", built " << info.buildTimestamp << ", "
                              << info.compiler << ", " << info.system << ')';
    return debug;
}

} // namespace app
