#pragma once

#include <QtCore/QDebug>
#include <QtCore/QLibraryInfo>
#include <QtCore/qglobal.h>
#include <QtCore/QString>
#include <QtQmlIntegration/qqmlintegration.h>

#include <utility>

namespace app {

struct BuildInfo
{
    Q_GADGET
    QML_VALUE_TYPE(buildInfo)
    Q_PROPERTY(QString gitSha READ gitSha CONSTANT FINAL)
    Q_PROPERTY(QString buildType READ buildType CONSTANT FINAL)
    Q_PROPERTY(QString timestamp READ buildTimestamp CONSTANT FINAL)
    Q_PROPERTY(QString compiler READ compiler CONSTANT FINAL)
    Q_PROPERTY(QString system READ system CONSTANT FINAL)
    Q_PROPERTY(QString qtVersion READ qtVersion CONSTANT FINAL)
    Q_PROPERTY(bool sharedQt READ sharedQt CONSTANT FINAL)

public:
    BuildInfo() = default;
    BuildInfo(QString name, QString displayName, QString version, QString gitSha, QString buildType,
        QString buildTimestamp, QString compiler, QString system)
        : m_name(std::move(name))
        , m_displayName(std::move(displayName))
        , m_version(std::move(version))
        , m_gitSha(std::move(gitSha))
        , m_buildType(std::move(buildType))
        , m_buildTimestamp(std::move(buildTimestamp))
        , m_compiler(std::move(compiler))
        , m_system(std::move(system))
    {
    }

    [[nodiscard]] const QString &name() const { return m_name; }
    [[nodiscard]] const QString &displayName() const { return m_displayName; }
    [[nodiscard]] const QString &version() const { return m_version; }
    [[nodiscard]] const QString &gitSha() const { return m_gitSha; }
    [[nodiscard]] const QString &buildType() const { return m_buildType; }
    [[nodiscard]] const QString &buildTimestamp() const { return m_buildTimestamp; }
    [[nodiscard]] const QString &compiler() const { return m_compiler; }
    [[nodiscard]] const QString &system() const { return m_system; }
    [[nodiscard]] QString qtVersion() const { return QString::fromLatin1(QT_VERSION_STR); }
    [[nodiscard]] bool sharedQt() const { return QLibraryInfo::isSharedBuild(); }

private:
    friend QDebug operator<<(QDebug debug, const BuildInfo &info)
    {
        const QDebugStateSaver saver(debug);
        debug.noquote().nospace() << info.m_name << ' ' << info.m_version << " (" << info.m_gitSha
                                  << ", " << info.m_buildType << ", built " << info.m_buildTimestamp
                                  << ", " << info.m_compiler << ", " << info.m_system << ')';
        return debug;
    }

    QString m_name;
    QString m_displayName;
    QString m_version;
    QString m_gitSha;
    QString m_buildType;
    QString m_buildTimestamp;
    QString m_compiler;
    QString m_system;
};

inline const BuildInfo buildInfo{QString::fromUtf8("@PROJECT_NAME@"),
    QString::fromUtf8("@APP_DISPLAY_NAME@"),
    QString::fromUtf8("@PROJECT_VERSION@"),
    QString::fromUtf8("@APP_GIT_SHA@"),
    QString::fromUtf8("$<CONFIG>"),
    QString::fromUtf8("@APP_BUILD_TIMESTAMP@"),
    QString::fromUtf8("@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@"),
    QString::fromUtf8("@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@")};

} // namespace app
