#include "BuildInfo.hpp"

namespace app::platform {

const BuildInfo &buildInfo() noexcept
{
    static constexpr BuildInfo info{
        .name = u"@PROJECT_NAME@",
        .displayName = u"@APP_DISPLAY_NAME@",
        .version = u"@PROJECT_VERSION@",
        .gitSha = u"@APP_GIT_SHA@",
        .buildType = u"$<CONFIG>",
        .buildTimestamp = u"@APP_BUILD_TIMESTAMP@",
        .compiler = u"@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@",
        .system = u"@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@",
    };
    return info;
}

} // namespace app::platform
