# Editor settings only. Compiler warnings come from compile_commands.json (cmake/AppTargetDefaults.cmake)
# and clang-tidy checks from .clang-tidy, so every tool shares one definition.

CompileFlags:
  CompilationDatabase: build/dev
  # Show warnings as warnings while typing; the build still treats them as errors.
  Remove: [-Werror]

Index:
  StandardLibrary: true

Hover:
  ShowAKA: true

Documentation:
  CommentFormat: Markdown
