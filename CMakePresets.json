{
  "version": 10,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },

  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Debug build and all tests",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "asan",
      "displayName": "Debug build and all tests with AddressSanitizer and UBSan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release build, all tests and the package: what CI ships",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" },
        { "type": "package", "name": "release" }
      ]
    }
  ],

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": { "MACOSX_DEPLOYMENT_TARGET": "14.4" },
      "cacheVariables": {
        "Qt6_ROOT": "$env{Qt6_ROOT}",
        "CMAKE_COLOR_DIAGNOSTICS": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "VCPKG_INSTALL_OPTIONS": "--downloads-root=${sourceDir}/build/vcpkg-downloads;--x-buildtrees-root=${sourceDir}/build/vcpkg-buildtrees;--x-packages-root=${sourceDir}/build/vcpkg-packages;--clean-buildtrees-after-build;--clean-packages-after-build"
      }
    },
    { "name": "dev", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "asan", "inherits": "dev", "cacheVariables": { "APP_SANITIZERS": "address;undefined" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } }
  ],

  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "$comment": "Qt itself is not instrumented, so container-overflow reports would be false positives.",
        "ASAN_OPTIONS": "detect_container_overflow=0:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    { "name": "release", "inherits": "base", "configurePreset": "release" }
  ],

  "packagePresets": [
    { "name": "release", "configurePreset": "release" }
  ]
}
