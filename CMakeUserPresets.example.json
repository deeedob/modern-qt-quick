{
  "version": 10,
  "configurePresets": [
    {
      "name": "dev-vcpkg",
      "inherits": "dev",
      "cacheVariables": { "CMAKE_PREFIX_PATH": "", "VCPKG_MANIFEST_FEATURES": "qt" }
    },
    {
      "name": "asan-vcpkg",
      "inherits": "asan",
      "cacheVariables": { "CMAKE_PREFIX_PATH": "", "VCPKG_MANIFEST_FEATURES": "qt" }
    },
    {
      "name": "release-vcpkg",
      "inherits": "release",
      "cacheVariables": { "CMAKE_PREFIX_PATH": "", "VCPKG_MANIFEST_FEATURES": "qt" }
    }
  ],
  "buildPresets": [
    { "name": "dev-vcpkg", "configurePreset": "dev-vcpkg" },
    { "name": "asan-vcpkg", "configurePreset": "asan-vcpkg" },
    { "name": "release-vcpkg", "configurePreset": "release-vcpkg" }
  ],
  "testPresets": [
    { "name": "dev-vcpkg", "inherits": "base", "configurePreset": "dev-vcpkg" },
    { "name": "asan-vcpkg", "inherits": "asan", "configurePreset": "asan-vcpkg" },
    { "name": "release-vcpkg", "inherits": "base", "configurePreset": "release-vcpkg" }
