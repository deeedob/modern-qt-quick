  "packagePresets": [
    { "name": "release-vcpkg", "configurePreset": "release-vcpkg" }
  ],
  "workflowPresets": [
    {
      "name": "dev-vcpkg",
      "steps": [
        { "type": "configure", "name": "dev-vcpkg" },
        { "type": "build", "name": "dev-vcpkg" },
        { "type": "test", "name": "dev-vcpkg" }
      ]
    },
    {
      "name": "asan-vcpkg",
      "steps": [
        { "type": "configure", "name": "asan-vcpkg" },
        { "type": "build", "name": "asan-vcpkg" },
        { "type": "test", "name": "asan-vcpkg" }
      ]
    },
    {
      "name": "release-vcpkg",
      "steps": [
        { "type": "configure", "name": "release-vcpkg" },
        { "type": "build", "name": "release-vcpkg" },
        { "type": "test", "name": "release-vcpkg" },
        { "type": "package", "name": "release-vcpkg" }
      ]
    }
  ]
}
